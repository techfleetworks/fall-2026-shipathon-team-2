# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it holds your real keys.
#
# Project URL: Supabase → Connect button (top of dashboard),
#   or Settings → General → Project ID, as https://<project-id>.supabase.co
# Publishable key: Supabase → Settings → API Keys → Publishable key
# Never put the secret key (sb_secret_...) in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
